# =============================================================================
# HotelOps AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values for local development.
# Never commit .env to version control.
#
# Docker hostnames (postgres, redis, minio) work from within Docker network.
# For host-machine access, use 127.0.0.1 (default ports are mapped).
#
# Port conflict note: If ports 5432 or 6379 are already in use on your
# machine, Docker Compose uses POSTGRES_HOST_PORT and REDIS_HOST_PORT
# for host-side port mapping to avoid conflicts.
# Container-internal ports remain standard.

# --- Application ---
APP_NAME=HotelOps AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL (Docker internal: postgres:5432) ---
# FastAPI connects via POSTGRES_HOST / POSTGRES_PORT (host side).
# Docker Compose maps POSTGRES_HOST_PORT -> container 5432.
# If you already run PostgreSQL on 5432, set POSTGRES_PORT to a
# free port and adjust POSTGRES_HOST_PORT to match.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=hotelops
POSTGRES_USER=hotelops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5433

# --- Redis (Docker internal: redis:6379) ---
# Same pattern: REDIS_PORT is what FastAPI connects to on the host.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380

# --- Object Storage / MinIO (Docker internal: minio:9000) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=hotelops-development
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# --- Cameras (future) ---
CAMERA_RTSP_USER=
CAMERA_RTSP_PASSWORD=

# --- LLM / AI (future) ---
LLM_API_KEY=
LLM_MODEL=

# --- Security (future) ---
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
